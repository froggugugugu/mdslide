{
  "name": "mdslide",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dev:web": "vite",
    "build:web": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:py": "python3 -m pytest tests/python -q --cov=tools --cov-report=term-missing",
    "test:e2e": "python3 -m pytest tests/e2e -q -m 'not electron'",
    "test:e2e:electron": "electron-vite build && python3 -m pytest tests/e2e -q -m electron",
    "test:all": "npm run typecheck && npm run test:coverage && npm run test:py && npm run test:e2e",
    "postinstall": "electron-rebuild -f -w node-pty || echo 'electron-rebuild failed: the console will use the node host fallback'",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.10",
    "@lezer/highlight": "1.2.3",
    "@replit/codemirror-vim": "6.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "5.0.0",
    "codemirror": "6.0.2",
    "idb-keyval": "6.3.0",
    "jszip": "3.10.1",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "main": "out/main/main.js"
}
